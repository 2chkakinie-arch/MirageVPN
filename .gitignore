# deps / build
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# runtime state (settings, pool snapshot, threat report) — never commit
data/state/
data/*.json
!data/seeds/*.json
*.log
logs/

# local env
.env
.env.*
!.env.example

# editor / os
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# tls fixtures for tests (regenerate with `npm run fixtures:tls`)
test/fixtures/*.pem
test/fixtures/*.key
test/fixtures/*.crt

# vercel / misc
.vercel/
.vercel-tmp/
.cache/
coverage/
