# MirageVPN — 環境変数テンプレート
# ---------------------------------------------------------------
# すべて任意。未設定でも動きます (既定値は server/config.js が持つ)。
# 本番デプロイで最低限やること: MIRAGE_SECRET を長いランダム値にすること。
#
#   cp .env.example .env        # node server/index.js は .env を読まない点に注意
#   node -r dotenv/config ...   # 必要なら dotenv を挟むか、host の UI/CLI で設定する

# ---------- 基本 ----------
PORT=8080
HOSTNAME_BIND=0.0.0.0
NODE_ENV=production
# 外部 URL (プロキシの注入パスを組み立てるベース)。サブパス配信時: https://例.com/mirage
MIRAGE_PUBLIC_BASE=
# サブパスデプロイ (例: /mirage)。通常は空で良い
MIRAGE_BASE_PATH=
# クッキー署名などの署名鍵。**必ず変える**
MIRAGE_SECRET=change-me-to-a-long-random-string
MIRAGE_LOG_LEVEL=info

# ---------- トランスポート ----------
# uv (既定・高速) | wisp (WS 多重トンネル) | auto
MIRAGE_MODE=uv
# WISP WebSocket の有効/無効 (Vercel では自動で無効化される)
MIRAGE_WISP=1
MIRAGE_WISP_MAX_STREAMS=64
MIRAGE_WISP_KEEPALIVE=20000
MIRAGE_WISP_MAX_FRAME=524288
MIRAGE_WISP_HWM=2097152
# URL のホスト符号化: token (base64url) | plain
MIRAGE_URL_ENCODING=token

# ---------- 出口 (プロキシプール) ----------
# auto (既定) = プール優先・失敗時 direct / pool = プール必須 / direct = 素の自 IP
MIRAGE_EGRESS=auto
# 初期出口国 (2 文字)。空 = 自動判定
MIRAGE_COUNTRY=
# 利用プロトコル (カンマ区切り)
MIRAGE_EGRESS_PROTOCOLS=http,https,socks5,socks4
# GitHub リストの取り込み間隔 (ms) と初回起動時の同梱シード利用
MIRAGE_LIST_AUTO_REFRESH=1
MIRAGE_LIST_REFRESH=1800000
MIRAGE_USE_SEED=1
MIRAGE_MAX_POOL=1200
MIRAGE_MAX_LATENCY=4200
MIRAGE_FAIL_THRESHOLD=3
MIRAGE_PROXY_COOLDOWN=900000
MIRAGE_HEALTHCHECK_INTERVAL=300000
MIRAGE_EGRESS_RETRIES=2
# 自前で追加したいリスト (カンマ区切り)。owner/repo#branch#path#proto#format 形式も可
MIRAGE_PROXY_SOURCES=
# 上流へ送る X-Forwarded-For 等の偽装
MIRAGE_SPOOF_FORWARDED=1
# 出口国に合わせた Accept-Language / UA に寄せる
MIRAGE_LOCALIZE_HEADERS=1
MIRAGE_SEND_PRIVACY_SIGNALS=1
MIRAGE_USER_AGENT=

# ---------- シールド (Brave 風の広告ブロック) ----------
MIRAGE_ADBLOCK=1
MIRAGE_PRIVACY_LEVEL=standard
MIRAGE_COSMETIC=1
MIRAGE_MAX_RULES=260000
MIRAGE_UNBREAKABLE=1
# 追加フィルタ (カンマ区切り URL / repo#branch#path)
# 同梱シードのパス (通常は変えない。'' にすると外部リストだけ/use nothing)
MIRAGE_ADBLOCK_SEED=data/adblock/mirage-shields.seed.txt
# hard-block 層: どのリストも取得できなくても広告網を落とす 100 行 (無効化したいなら '' )
MIRAGE_ADBLOCK_HOSTS_SEED=data/adblock/hosts.seed.txt
MIRAGE_AD_LISTS=
MIRAGE_AD_LIST_REFRESH=43200000

# ---------- 脅威検知 ----------
MIRAGE_THREAT_SCAN=1
MIRAGE_THREAT_AUTODELETE=1
# sanitize 以上で要素を自動削除 / block 以上でページ表示を遮断
MIRAGE_THREAT_SANITIZE_SCORE=40
MIRAGE_THREAT_BLOCK_SCORE=80
MIRAGE_THREAT_SCAN_BYTES=3145728
MIRAGE_THREAT_REPORT_SIZE=800
MIRAGE_THREAT_RETENTION=86400000
MIRAGE_BLOCK_DANGEROUS_FILES=1
MIRAGE_CRED_GUARD=1

# ---------- 安全性 / 制限 ----------
# SSRF ガード (private/loopback 遮断)。**ローカル検証以外では 1 のままにすること**
MIRAGE_BLOCK_PRIVATE_TARGETS=1
MIRAGE_ALLOW_PROTOCOLS=http:,https:
MIRAGE_WARN_CREDENTIALS=1
MIRAGE_REDACT_LOG=1
MIRAGE_KILL_SWITCH=0
MIRAGE_RATE_REQ=900
MIRAGE_RATE_BYTES=230686720
MIRAGE_MAX_CONCURRENT=24
MIRAGE_RATE_WINDOW=60000
MIRAGE_CONNECT_TIMEOUT=12000
MIRAGE_RESPONSE_TIMEOUT=35000
MIRAGE_MAX_BODY=25165824
MIRAGE_MAX_REDIRECTS=6

# ---------- キャッシュ / 永続化 ----------
MIRAGE_CACHE=1
MIRAGE_CACHE_TTL=300000
MIRAGE_CACHE_MAX=67108864
# 設定/統計を磁盘に保存するディレクトリ (Vercel では書けないので自動 OFF)
MIRAGE_STATE_DIR=
MIRAGE_PERSIST=1

# ---------- その他 ----------
MIRAGE_SEARCH_ENGINE=duckduckgo
MIRAGE_METRICS=1
MIRAGE_SLOW_MS=4000
MIRAGE_PANIC_KEYS=Shift+Escape
